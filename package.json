{
  "name": "embus",
  "version": "1.0.0",
  "description": "A lightweight JavaScript HTTP client based on Fetch API",
  "keywords": [
    "api",
    "fetch",
    "http",
    "https",
    "request"
  ],
  "homepage": "https://github.com/xueelf/embus#readme",
  "bugs": {
    "url": "https://github.com/xueelf/embus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xueelf/embus.git"
  },
  "license": "MIT",
  "author": "Yuki <admin@yuki.sh>",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run scripts/build.ts",
    "format": "prettier \"**/*.{json,md,ts,yaml,yml}\" --write --experimental-cli",
    "format:check": "prettier \"**/*.{json,md,ts,yaml,yml}\" --check --experimental-cli",
    "lint": "eslint --cache",
    "lint:fix": "eslint --fix --cache",
    "prepare": "husky",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.3.14",
    "annal": "^0.0.2",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.6",
    "prettier-plugin-sort": "^1.0.0",
    "typescript-eslint": "^8.65.0"
  },
  "peerDependencies": {
    "typescript": "^6.0.3"
  },
  "devEngines": {
    "runtime": {
      "name": "bun",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "bun",
      "onFail": "warn"
    }
  }
}
